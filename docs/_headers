# Security headers untuk Cloudflare Pages (juga dibaca Netlify).
# GitHub Pages mengabaikan file ini; itu normal untuk mirror.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Jangan biarkan Google mengindeks template tulisan.
/writing/post-template/*
  X-Robots-Tag: noindex

# Jangan biarkan alamat *.pages.dev diindeks sebagai duplikat domain utama.
# ":project" adalah placeholder Cloudflare yang cocok dengan nama project apa pun; biarkan apa adanya.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
